{
  "name": "projeto-multifarma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hub Omnichannel de Atendimento e Vendas para Farmácia",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "seed:auth": "node scripts/seed-auth-users.js",
    "start": "node scripts/start-production.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
