# Hub MultiFarma - Variáveis de Ambiente de Exemplo
# NUNCA adicione credenciais reais a este arquivo ou no repositório Git!

# URLs Principais
APP_BASE_URL=http://localhost:3000
PORT=3001
NODE_ENV=development

# Chatwoot Self-Hosted
CHATWOOT_BASE_URL=https://chatwoot.homologacao.farmacia.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=chatwoot_access_token_aqui
CHATWOOT_INBOX_IDS=1,2,3
CHATWOOT_WEBHOOK_SECRET=chatwoot_webhook_secret_aqui

# Evolution API
EVOLUTION_API_URL=https://evolution.homologacao.farmacia.com
EVOLUTION_API_KEY=evolution_global_api_key_aqui
EVOLUTION_INSTANCE_NAME=farmacia-homolog

# Supabase Hub
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_key_exemplo_browser
SUPABASE_SECRET_KEY=sb_secret_key_exemplo_server_only

# Inteligência Artificial
AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash
AI_API_KEY=sua_api_key_aqui

# Segurança e Criptografia
INTEGRATION_ENCRYPTION_KEY=chave_secreta_32_bytes_hexadecimal
SENTRY_DSN=https://exemplo@sentry.io/12345

# P0: sessão web e contexto do iframe (origens exatas, sem barra final)
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CHATWOOT_ORIGIN=https://chatwoot.homologacao.farmacia.com
# Deve ser único, aleatório e ter pelo menos 32 caracteres; nunca usar este placeholder.
HUB_INTERNAL_TOKEN=substituir_por_segredo_aleatorio_de_32_ou_mais_caracteres
# CHATWOOT_WEBHOOK_SECRET assina timestamp.rawBody com HMAC-SHA256.
# O emissor/ingress confiável deve suportar este protocolo; não presumir assinatura nativa.
# Mapeamento explícito por inbox; IDs abaixo são exemplos sintéticos.
CHATWOOT_INBOX_MAP={"1":{"organization_id":"11111111-1111-1111-1111-111111111111","branch_id":"22222222-2222-2222-2222-222222222221","channel":"whatsapp"}}
# Preços de sugestões existentes são sintéticos: só permitir em ambiente demo isolado.
DEMO_MODE=false
